# Copy to .env for local dev. On Railway/Render, set these as project env vars instead.

# Postgres connection string. Railway/Render/Neon/Supabase all give you one
# of these when you provision a database.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret used to sign auth JWTs — generate with: openssl rand -hex 32
JWT_SECRET=

# Anthropic API key, used by the AI planner and the NL-modification interpreter.
AI_PROVIDER_API_KEY=
AI_MODEL=claude-sonnet-5

# Comma-separated list of frontend origins allowed to call this API.
# Include your Vercel URL and localhost for local dev.
FRONTEND_ORIGINS=http://localhost:5173,https://your-app.vercel.app
